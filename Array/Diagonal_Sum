class Solution {
    public int diagonalSum(int[][] mat) {
        int n = mat.length;
        int sum = 0;
        
        for(int i = 0; i < n; i++) {
            // Primary Diagonal
            sum += mat[i][i];   

            // Secondary diagonal
            int j = n - 1 - i;

            if(i != j) {  // Skip Middle idx
                sum += mat[i][j];
            }
        }

        return sum;
    }
}
